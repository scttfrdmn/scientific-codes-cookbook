{
  "task_id": "cookbook-gromacs-decomp",
  "command": [
    "bash",
    "-c",
    "set +e\ncd /tmp\nsha256sum -c pins.sha256 || { echo \"FAIL: a staged script does not match its pin\"; exit 1; }\nbash host.sh\nbash decomp.sh\n"
  ],
  "container": "quay.io/aarchsci/md@sha256:1ee941664add6f83b367c012d0cc670ffc837e83ee491125993de72e88c22ab9",
  "resources": {
    "cpu": 16,
    "memory_gib": 30,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/gromacs/benchMEM.tpr",
      "destination": "/tmp/benchMEM.tpr"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/gromacs-real/host.sh",
      "destination": "/tmp/host.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/gromacs-real/decomp.sh",
      "destination": "/tmp/decomp.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/gromacs-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/decomp.txt",
      "destination": "s3://${COOKBOOK_BUCKET}/measurements/gromacs-real/decomp.txt"
    },
    {
      "source": "/tmp/decomp.tsv",
      "destination": "s3://${COOKBOOK_BUCKET}/measurements/gromacs-real/decomp.tsv"
    }
  ],
  "lifecycle": {
    "ttl": "45m",
    "on_complete": "terminate",
    "cost_limit": 0.22
  }
}

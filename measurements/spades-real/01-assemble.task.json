{
  "task_id": "cookbook-spades-real-assemble",
  "container": "quay.io/aarchbio/spades@sha256:f8b7ad9acda742d695be9176c1fec0e9a33579a6a19294d3d2a3516ade3de81c",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (assemble\\.sh|DRR171213_1\\.fastq\\.gz|DRR171213_2\\.fastq\\.gz)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 3 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash assemble.sh DRR171213 8 14\n"
  ],
  "resources": {
    "cpu": 8,
    "memory_gib": 16,
    "architecture": "arm64",
    "families": [
      "c8g"
    ],
    "disk_gib": 60
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/prep/DRR171213_1.fastq.gz",
      "destination": "/tmp/DRR171213_1.fastq.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/prep/DRR171213_2.fastq.gz",
      "destination": "/tmp/DRR171213_2.fastq.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/assemble.sh",
      "destination": "/tmp/assemble.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/spades-real/DRR171213/"
    }
  ],
  "lifecycle": {
    "ttl": "90m",
    "on_complete": "terminate",
    "cost_limit": 0.4
  }
}

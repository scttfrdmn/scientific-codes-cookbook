    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/prep/pairs.txt",
      "destination": "/tmp/pairs.txt"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/evaluate.sh",
      "destination": "/tmp/evaluate.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/spades-real/DRR171213/contigs.fasta",
      "destination": "/tmp/arm64.contigs.fasta"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/spades-real/DRR171213/spades.log",

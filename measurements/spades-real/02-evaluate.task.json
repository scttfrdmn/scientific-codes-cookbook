{
  "task_id": "cookbook-spades-real-evaluate",
  "container": "quay.io/aarchbio/quast@sha256:54122e645394aa741656c54ecdde8737b2ad8cc0ef6ead72392c1be8248ae692",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (evaluate\\.sh|GCF_000005845\\.2\\.fna\\.gz|pairs\\.txt)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 3 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash evaluate.sh GCF_000005845.2.fna.gz 4 arm64 x86_64 amd\n"
  ],
  "resources": {
    "cpu": 4,
    "memory_gib": 8,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/spades-real/prep/GCF_000005845.2.fna.gz",

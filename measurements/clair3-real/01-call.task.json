{
  "task_id": "cookbook-clair3-real-call",
  "container": "quay.io/aarchbio/clair3@sha256:b464803435a71829228bedd4641d994018106952d746517188761d7dbd7bd289",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (call\\.sh|lib\\.sh|hifi\\.chr20\\.bam|hifi\\.chr20\\.bam\\.bai|chr20\\.fa|chr20\\.fa\\.fai)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 6 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash call.sh\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "c8g"
    ],
    "disk_gib": 40
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/clair3-real/call.sh",
      "destination": "/tmp/call.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/clair3-real/lib.sh",
      "destination": "/tmp/lib.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/clair3-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/prep/hifi.chr20.bam",
      "destination": "/tmp/hifi.chr20.bam"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/prep/hifi.chr20.bam.bai",
      "destination": "/tmp/hifi.chr20.bam.bai"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bwa-samtools/chr20.fa",
      "destination": "/tmp/chr20.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/prep/chr20.fa.fai",
      "destination": "/tmp/chr20.fa.fai"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/clair3-real/call/"
    }
  ],
  "lifecycle": {
    "ttl": "2h",
    "on_complete": "terminate",
    "cost_limit": 1.0
  }
}

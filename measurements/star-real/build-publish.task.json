{
  "task_id": "starreal-build-publish2",
  "container": "quay.io/aarchbio/star@sha256:90331f64bd73eadaefbebc8d4aecfed3ebed1a7e40b761041acbbcf53b3e13ae",
  "command": [
    "bash",
    "-c",
    "export THREADS=32\nset -euo pipefail\nexport PATH=/opt/conda/bin:$PATH\nexport TMPDIR=/tmp HOME=/tmp\ncd /tmp\nTHREADS=\"${THREADS:-32}\"\ngunzip -c GRCh38.primary_assembly.fa.gz > genome.fa\ngunzip -c GRCh38.116.gtf.gz            > genes.gtf\necho \"== build the full human index once ==\"\nT0=$(date +%s)\nSTAR --runMode genomeGenerate --runThreadN \"$THREADS\" --genomeDir idx \\\n     --genomeFastaFiles genome.fa --sjdbGTFfile genes.gtf --sjdbOverhang 100 \\\n     --outFileNamePrefix gg_ > gg.log 2>&1 || { tail -20 gg.log Log.out 2>/dev/null; exit 1; }\nT1=$(date +%s)\n# Flatten into /tmp so each file can be a declared spawn output. This image has neither aws\n# nor python3, so the upload MUST be spawn's stage-out, not a CLI call inside the container.\nfor f in idx/*; do cp \"$f\" \"/tmp/idx_$(basename \"$f\")\"; done\n{ printf 'star_version\\t%s\\n' \"$(STAR --version)\"\n  printf 'threads\\t%s\\n' \"$THREADS\"\n  printf 'index_wall_s\\t%s\\n' \"$(( T1 - T0 ))\"\n  printf 'index_bytes\\t%s\\n' \"$(du -sb idx | awk '{print $1}')\"\n  printf 'index_files\\t%s\\n' \"$(ls idx | wc -l)\"\n} | tee index-stats.txt\nls -l idx | awk 'NR>1{printf \"  %-28s %s\\n\", $9, $5}'\necho \"BUILD OK -- spawn stages the index out\"\n"
  ],
  "resources": {
    "cpu": 32,
    "memory_gib": 240,
    "architecture": "arm64",
    "families": [
      "r8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/star-real/GRCh38.primary_assembly.fa.gz",
      "destination": "/tmp/GRCh38.primary_assembly.fa.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/star-real/GRCh38.116.gtf.gz",
      "destination": "/tmp/GRCh38.116.gtf.gz"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/idx_chrLength.txt",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/star-index-GRCh38-116/chrLength.txt"
    },
    {
      "source": "/tmp/idx_chrNameLength.txt",

      "destination": "s3://${COOKBOOK_BUCKET}/inputs/star-index-GRCh38-116/exonGeTrInfo.tab"
    },
    {
      "source": "/tmp/idx_exonInfo.tab",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/star-index-GRCh38-116/exonInfo.tab"
    },

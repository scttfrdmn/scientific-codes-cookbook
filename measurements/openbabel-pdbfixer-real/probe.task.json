{
  "task_id": "cookbook-openbabel-pdbfixer-real-probe",
  "container": "quay.io/aarchsci/comp-chem@sha256:b5c1b1ec10cfbb5374d0e733310244f84b59dc4ce99620b645c4efb6f49c439d",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\nset -uo pipefail\ncd /tmp\nsha256sum -c scripts.sha256 || { echo \"FAIL: a script does not match its pin\"; exit 1; }\nsha256sum -c pins.sha256 || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nsha256sum -c --status cohort.sha256 || { echo \"FAIL: a staged entry does not match cohort.sha256\"; exit 1; }\necho \"cohort: $(grep -c . cohort.sha256) entries match cohort.sha256\"\nOUTDIR=/tmp/out/ob bash real.sh ob /tmp/chembl37/chembl_37_chemreps.txt.gz /tmp/rdkit_real.tsv.gz 16 50000\nOUTDIR=/tmp/out/fix bash real.sh fix /tmp/pdb 16 /tmp/probe-ids.txt\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "c8g"
    ],
    "disk_gib": 40
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/ob_real.py",
      "destination": "/tmp/ob_real.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/fix_real.py",
      "destination": "/tmp/fix_real.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/real.sh",
      "destination": "/tmp/real.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/scripts.sha256",
      "destination": "/tmp/scripts.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/rdkit-real/chembl37/chembl_37_chemreps.txt.gz",
      "destination": "/tmp/chembl37/chembl_37_chemreps.txt.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/rdkit-real/chembl37/rdkit_real.tsv.gz",
      "destination": "/tmp/rdkit_real.tsv.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/pdb-20260101/ab/",
      "destination": "/tmp/pdb/"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/cohort.sha256",
      "destination": "/tmp/cohort.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/openbabel-pdbfixer-real/probe-ids.txt",
      "destination": "/tmp/probe-ids.txt"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/openbabel-pdbfixer-real/probe/"
    }
  ],
  "lifecycle": {
    "ttl": "2h",
    "on_complete": "terminate",
    "cost_limit": 1.0
  }
}

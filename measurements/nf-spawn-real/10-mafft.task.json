{
  "task_id": "cookbook-nf-spawn-real-mafft",
  "container": "quay.io/aarchbio/mafft@sha256:f23e4545b6c186ffa31ebbb0a70a051c06ff3e7dcc91853e84f6eced74fa3df9",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e (spawn#707)\ncd /tmp\ngrep -E ' (direct\\.sh|mafft\\.sh|pf01255\\.25_unaligned\\.fa)$' pins.sha256 > p.sha256\n[ \"$(wc -l < p.sha256)\" -eq 3 ] && sha256sum -c p.sha256 || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash direct.sh mafft mafft.sh pf01255.25_unaligned.fa\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 4,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/nf-spawn-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/nf-spawn-real/direct.sh",
      "destination": "/tmp/direct.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/nf-spawn-real/mafft.sh",
      "destination": "/tmp/mafft.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mafft-real/pf01255.25_unaligned.fa",
      "destination": "/tmp/pf01255.25_unaligned.fa"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/nf-spawn-real/r1/direct/"
    }
  ],
  "lifecycle": {
    "ttl": "1h",
    "on_complete": "terminate",
    "cost_limit": 0.1
  }
}

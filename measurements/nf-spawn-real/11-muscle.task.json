{
  "task_id": "cookbook-nf-spawn-real-muscle",
  "container": "quay.io/aarchbio/muscle@sha256:ecfe0f7405a5e3e1237b93202c35bd984aab96e1a3466ef64a6fd0a3b7d5c2e4",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e (spawn#707)\ncd /tmp\ngrep -E ' (direct\\.sh|muscle\\.sh|pf01255\\.25_unaligned\\.fa)$' pins.sha256 > p.sha256\n[ \"$(wc -l < p.sha256)\" -eq 3 ] && sha256sum -c p.sha256 || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash direct.sh muscle muscle.sh pf01255.25_unaligned.fa\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/nf-spawn-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/nf-spawn-real/direct.sh",
      "destination": "/tmp/direct.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/nf-spawn-real/muscle.sh",
      "destination": "/tmp/muscle.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mafft-real/pf01255.25_unaligned.fa",
      "destination": "/tmp/pf01255.25_unaligned.fa"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/nf-spawn-real/r1/direct/"
    }
  ],
  "lifecycle": {
    "ttl": "2h",
    "on_complete": "terminate",
    "cost_limit": 1.0
  }
}

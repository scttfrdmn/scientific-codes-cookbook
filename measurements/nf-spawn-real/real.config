// nf-spawn-real: recipes/nf-spawn/main.nf, unchanged, over the whole PF01255.25 seed (919
// sequences). This file replaces the recipe's nextflow.config for the real workload; run.sh sets
// the environment it reads. Everything that differs from the recipe's config is a sizing or a
// bookkeeping choice:
//   - nf-spawn 0.11.0, the first release with ext.costLimit, so every process carries a cost cap
//     as well as a TTL (0.10.1 can set only the TTL);
//   - MUSCLE on a 4xlarge, not the recipe's large: `muscle -align`'s memory grows as about n^2
//     (00-probe: 0.17 / 0.52 / 1.42 GiB at 115 / 230 / 460 sequences), so 919 cannot fit 4 GiB;
//   - a work dir and a publish prefix per chip and run, so no run can resume or overwrite another,
//     and every process publishes its outputs (the recipe publishes only OBSERVE_RF's);
//   - NF_REAL_EDIT=1 names OBSERVE_RF's image as `repo:tag@digest` instead of `repo@digest`: the
//     same bytes under a different reference. Measured: it re-runs nothing, because Nextflow puts
//     the image in a task's cache key only when a container engine is enabled, and nf-spawn runs
//     Docker itself with none enabled. NF_REAL_NOCACHE=1 turns OBSERVE_RF's cache off instead.
plugins {
    id 'nf-spawn@0.11.0'
}

workDir = "s3://${System.getenv('COOKBOOK_BUCKET')}/nextflow-work/nf-spawn-real-${System.getenv('NF_REAL_RUN')}"

trace {
    enabled   = false
    fields    = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,workdir,container'
    overwrite = true
}

process {
    executor   = 'spawn'
    ext.region = System.getenv('AWS_REGION')

    withName: 'MAFFT' {
        ext.instanceType = "${System.getenv('NF_REAL_FAM')}.large"
        ext.ttl = '30m'; ext.costLimit = '0.10'
        publishDir = [path: "${System.getenv('NF_REAL_PUB')}/mafft", mode: 'copy']
    }
    withName: 'MUSCLE' {
        ext.instanceType = "${System.getenv('NF_REAL_FAM')}.4xlarge"
        ext.ttl = '2h'; ext.costLimit = '1.00'
        publishDir = [path: "${System.getenv('NF_REAL_PUB')}/muscle", mode: 'copy']
    }
    withName: 'TREE' {
        ext.instanceType = "${System.getenv('NF_REAL_FAM')}.xlarge"
        ext.ttl = '8h'; ext.costLimit = '1.50'
        publishDir = [path: "${System.getenv('NF_REAL_PUB')}/tree", mode: 'copy']
    }
    withName: 'OBSERVE_RF' {
        ext.instanceType = "${System.getenv('NF_REAL_FAM')}.large"
        ext.ttl = '30m'; ext.costLimit = '0.10'
        publishDir = [path: "${System.getenv('NF_REAL_PUB')}/rf", mode: 'copy']
        cache = System.getenv('NF_REAL_NOCACHE') ? false : true
    }
}

profiles {
    arm64 {
        process {
            withName: 'OBSERVE_RF' {
                container = System.getenv('NF_REAL_EDIT') ?
                    'quay.io/aarchbio/iqtree:nf-spawn-real-edit@sha256:dc6d9f62d56fd1ca92bfb2a9fbd162d419d4f866de67e6e879ba0f895d2a6fb7' :
                    'quay.io/aarchbio/iqtree@sha256:dc6d9f62d56fd1ca92bfb2a9fbd162d419d4f866de67e6e879ba0f895d2a6fb7'
            }
        }
    }
    // Intel (NF_REAL_FAM=c8i) and AMD (c8a) run the same x86 pins: the recipe's images_x86_64.
    x86 {
        process {
            withName: 'MAFFT'  { container = 'quay.io/biocontainers/mafft@sha256:b8ccc402a9156868fefda5caa8693f847b47dcc69aae848557f7115850e60790' }
            withName: 'MUSCLE' { container = 'quay.io/biocontainers/muscle@sha256:d8a60b266ec5ff7c3be76e2ed3ffb8d42cb4ecc882d5d6e0af6d5c54a428bcdb' }
            withName: 'TREE'   { container = 'quay.io/biocontainers/iqtree@sha256:3a7fc305372d818447197cfcb2f870797036170d7ecc7ea656a94c0de250b78d' }
            withName: 'OBSERVE_RF' {
                container = System.getenv('NF_REAL_EDIT') ?
                    'quay.io/biocontainers/iqtree:nf-spawn-real-edit@sha256:3a7fc305372d818447197cfcb2f870797036170d7ecc7ea656a94c0de250b78d' :
                    'quay.io/biocontainers/iqtree@sha256:3a7fc305372d818447197cfcb2f870797036170d7ecc7ea656a94c0de250b78d'
            }
        }
    }
}

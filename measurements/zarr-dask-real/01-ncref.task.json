{
  "task_id": "cookbook-zarr-dask-real-ncref",
  "container": "quay.io/aarchsci/climate@sha256:5b3d840e79eabaa222b8766f08e998dea87313696da6cafd8a9740cde69b9ac7",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\nsha256sum -c pins.sha256 || { echo \"FAIL: a staged script does not match its pin\"; exit 1; }\nbash run.sh ncref 1\n"
  ],
  "resources": {
    "cpu": 4,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "r8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/zarr-dask-real/nc/",
      "destination": "/tmp/nc/"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/zarr-dask-real/ncref.py",
      "destination": "/tmp/ncref.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/zarr-dask-real/real.py",
      "destination": "/tmp/real.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/zarr-dask-real/run.sh",
      "destination": "/tmp/run.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/zarr-dask-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/zarr-dask-real/esgf-nc.sha256",
      "destination": "/tmp/esgf-nc.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/zarr-dask-real/ncref/"
    }
  ],
  "lifecycle": {
    "ttl": "2h",
    "on_complete": "terminate",
    "cost_limit": 0.5
  }
}

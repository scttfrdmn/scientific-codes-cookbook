{
  "task_id": "cookbook-siesta-real-suite",
  "container": "quay.io/aarchsci/dft@sha256:b356499318a2a257b475cbd2d35372d0e91c2fba2b35e9b5c2051596814bc049",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\nsha256sum -c --quiet pins.sha256 || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\necho \"pins: $(grep -c . pins.sha256) files verified\"\nbash real.sh /tmp/suite 4 4 16\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 32,
    "disk_gib": 40,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/siesta-real/suite/",
      "destination": "/tmp/suite/"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/siesta-real/real.py",
      "destination": "/tmp/real.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/siesta-real/real.sh",
      "destination": "/tmp/real.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/siesta-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/siesta-real/suite/"
    }
  ],
  "lifecycle": {
    "ttl": "5h",
    "on_complete": "terminate",
    "cost_limit": 2.5
  }
}

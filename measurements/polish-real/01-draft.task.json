{
  "task_id": "cookbook-polish-real-draft",
  "container": "quay.io/aarchbio/flye@sha256:d87ccd4e29f2995e6bbcea9f72e90f575897a5489b472111695320bd8528dc12",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\nexport PATH=/opt/conda/bin:$PATH TMPDIR=/var/tmp HOME=/var/tmp\ncd /tmp\ngrep -E ' (common\\.sh|run\\.py|draft\\.sh|ERR12813217\\.fastq\\.gz)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -eq 4 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash draft.sh 8\n"
  ],
  "resources": {
    "cpu": 8,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "m8g"
    ],
    "disk_gib": 100
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/common.sh",
      "destination": "/tmp/common.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/run.py",
      "destination": "/tmp/run.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/draft.sh",
      "destination": "/tmp/draft.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/reads/ERR12813217.fastq.gz",
      "destination": "/tmp/ERR12813217.fastq.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/var/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/draft/"
    }
  ],
  "lifecycle": {
    "ttl": "6h",
    "on_complete": "terminate",
    "cost_limit": 2.0
  }
}

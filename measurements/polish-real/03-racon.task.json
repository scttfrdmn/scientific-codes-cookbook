{
  "task_id": "cookbook-polish-real-racon",
  "container": "quay.io/aarchbio/racon@sha256:75020311bdb6a635ee67718984db28029e95ee2272e32de9d0def8a9826ed4ee",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\nexport PATH=/opt/conda/bin:$PATH TMPDIR=/var/tmp HOME=/var/tmp\ncd /tmp\ngrep -E ' (common\\.sh|run\\.py|racon\\.sh|ERR12813217\\.fastq\\.gz|draft\\.fa|ov\\.paf)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -eq 6 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash racon.sh 8\n"
  ],
  "resources": {
    "cpu": 8,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "m8g"
    ],
    "disk_gib": 40
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/common.sh",
      "destination": "/tmp/common.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/run.py",
      "destination": "/tmp/run.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/racon.sh",
      "destination": "/tmp/racon.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/reads/ERR12813217.fastq.gz",
      "destination": "/tmp/ERR12813217.fastq.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/draft/draft.fa",
      "destination": "/tmp/draft.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/overlap/ov.paf",
      "destination": "/tmp/ov.paf"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/polish-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/var/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/polish-real/"
    }
  ],
  "lifecycle": {
    "ttl": "6h",
    "on_complete": "terminate",
    "cost_limit": 2.0
  }
}

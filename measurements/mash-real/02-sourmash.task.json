{
  "task_id": "cookbook-mash-real-sourmash",
  "container": "quay.io/aarchbio/sourmash@sha256:29733e7ac937dd17d8c7b84130f36b41da1a33f02abab0b2276c92c2683abd10",
  "command": [
    "bash",
    "-c",
    "set +e\ncd /tmp\ngrep -E ' (sourmash_xcheck\\.py|genomes\\.tar|genomes\\.tsv|species\\.tsv)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -eq 4 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nexport PATH=/opt/conda/bin:/usr/local/bin:$PATH HOME=/tmp TMPDIR=/var/tmp\npython3 -u sourmash_xcheck.py 16 || exit 1\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "c8g"
    ],
    "disk_gib": 40
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mash-real/sourmash_xcheck.py",
      "destination": "/tmp/sourmash_xcheck.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mash-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mash-real/prep/genomes.tar",
      "destination": "/tmp/genomes.tar"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mash-real/prep/genomes.tsv",
      "destination": "/tmp/genomes.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mash-real/prep/species.tsv",
      "destination": "/tmp/species.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/mash-real/nearest.tsv",
      "destination": "/tmp/mash_nearest.tsv"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/mash-real-sourmash/"
    }
  ],
  "lifecycle": {
    "ttl": "2h",
    "on_complete": "terminate",
    "cost_limit": 0.4
  }
}

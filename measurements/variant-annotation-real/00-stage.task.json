{
  "task_id": "cookbook-varann-real-stage",
  "command": [
    "bash",
    "-c",
    "set +e\nbash /tmp/fetch-ensembl.sh\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 4,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/fetch-ensembl.sh",
      "destination": "/tmp/fetch-ensembl.sh"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/"
    }
  ],
  "lifecycle": {
    "ttl": "30m",
    "on_complete": "terminate",
    "cost_limit": 0.05
  }
}

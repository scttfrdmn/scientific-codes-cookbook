{
  "task_id": "cookbook-varann-real-vep",
  "container": "quay.io/aarchbio/ensembl-vep@sha256:48593f3f9f40cd15c77adcf68f83fb7ee00d7fa35849d449cece48a504c76e01",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (vep\\.sh|compare\\.awk|hs37d5\\.chr20-22\\.fa|Homo_sapiens\\.GRCh37\\.pep\\.all\\.fa\\.gz|lib\\.sh|pairs\\.awk|Homo_sapiens\\.GRCh37\\.87\\.chromosome\\.20\\.gff3\\.gz|Homo_sapiens\\.GRCh37\\.87\\.chromosome\\.21\\.gff3\\.gz|Homo_sapiens\\.GRCh37\\.87\\.chromosome\\.22\\.gff3\\.gz)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 9 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash vep.sh 16\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "c8g"
    ],
    "disk_gib": 60
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/vep.sh",
      "destination": "/tmp/vep.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/compare.awk",
      "destination": "/tmp/compare.awk"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/Homo_sapiens.GRCh37.pep.all.fa.gz",
      "destination": "/tmp/Homo_sapiens.GRCh37.pep.all.fa.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/lib.sh",
      "destination": "/tmp/lib.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/pairs.awk",
      "destination": "/tmp/pairs.awk"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/Homo_sapiens.GRCh37.87.chromosome.20.gff3.gz",
      "destination": "/tmp/Homo_sapiens.GRCh37.87.chromosome.20.gff3.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/Homo_sapiens.GRCh37.87.chromosome.21.gff3.gz",
      "destination": "/tmp/Homo_sapiens.GRCh37.87.chromosome.21.gff3.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/Homo_sapiens.GRCh37.87.chromosome.22.gff3.gz",
      "destination": "/tmp/Homo_sapiens.GRCh37.87.chromosome.22.gff3.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bcftools-real/hs37d5.chr20-22.fa",
      "destination": "/tmp/hs37d5.chr20-22.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/variant-annotation-real/csq/sites.vcf.gz",
      "destination": "/tmp/sites.vcf.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/variant-annotation-real/csq/csq.pairs.tsv",
      "destination": "/tmp/csq.pairs.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/variant-annotation-real/snpeff/snpeff.pairs.tsv",
      "destination": "/tmp/snpeff.pairs.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/variant-annotation-real/vep/"
    }
  ],
  "lifecycle": {
    "ttl": "3h",
    "on_complete": "terminate",
    "cost_limit": 1.5
  }
}

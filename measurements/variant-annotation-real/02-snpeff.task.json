{
  "task_id": "cookbook-varann-real-snpeff",
  "container": "quay.io/aarchbio/snpeff@sha256:2183d4c0c4a11d58aa6c4cc5939ca26359fa07ba8e444ac4b9de297257eccf3a",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (snpeff\\.sh|hs37d5\\.chr20-22\\.fa|Homo_sapiens\\.GRCh37\\.cds\\.all\\.fa\\.gz|Homo_sapiens\\.GRCh37\\.pep\\.all\\.fa\\.gz|lib\\.sh|pairs\\.awk|Homo_sapiens\\.GRCh37\\.87\\.chromosome\\.20\\.gff3\\.gz|Homo_sapiens\\.GRCh37\\.87\\.chromosome\\.21\\.gff3\\.gz|Homo_sapiens\\.GRCh37\\.87\\.chromosome\\.22\\.gff3\\.gz)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 9 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash snpeff.sh \n"
  ],
  "resources": {
    "cpu": 4,
    "memory_gib": 8,
    "architecture": "arm64",
    "families": [
      "c8g"
    ],
    "disk_gib": 40
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/snpeff.sh",
      "destination": "/tmp/snpeff.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/Homo_sapiens.GRCh37.cds.all.fa.gz",
      "destination": "/tmp/Homo_sapiens.GRCh37.cds.all.fa.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/Homo_sapiens.GRCh37.pep.all.fa.gz",
      "destination": "/tmp/Homo_sapiens.GRCh37.pep.all.fa.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/lib.sh",
      "destination": "/tmp/lib.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/pairs.awk",
      "destination": "/tmp/pairs.awk"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/variant-annotation-real/Homo_sapiens.GRCh37.87.chromosome.20.gff3.gz",
      "destination": "/tmp/Homo_sapiens.GRCh37.87.chromosome.20.gff3.gz"

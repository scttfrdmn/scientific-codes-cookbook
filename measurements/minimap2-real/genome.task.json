{
  "task_id": "cookbook-minimap2real-genome",
  "container": "quay.io/aarchbio/minimap2@sha256:ef4a5fb788815f5f9fd88544affa6764b5dacfc425aaf249a4adcd51416c041a",
  "command": [
    "bash",
    "-c",
    "set +e\nset -uo pipefail\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\nexport PATH=/opt/conda/bin:$PATH TMPDIR=/tmp HOME=/tmp\ncd /tmp\nexport THREADS=32\necho '== staged bytes must match their pins =='\ngrep -E 'genome.sh|no_alt_analysis_set.fa$' pins.sha256 > pins.sel\ncat wg-pins.sha256 >> pins.sel\nsha256sum -c pins.sel > pins.check 2>&1 || { grep -v ': OK$' pins.check; echo 'FAIL: a staged input does not match its pin'; exit 1; }\necho \"$(wc -l < pins.sel) files match their pins\"\nT0=$(date +%s)\nbash genome.sh > run.log 2>&1\nRC=$?\necho \"genome.sh exit $RC in $(( $(date +%s) - T0 ))s\"\ncat run.log\ntest \"$RC\" = 0 || { echo 'FAIL: the workload failed'; exit 1; }\ngrep -q 'MINIMAP2 GENOME OK' run.log || { echo 'FAIL: no completion sentinel'; exit 1; }\necho DONE\n"
  ],
  "resources": {
    "cpu": 32,
    "memory_gib": 256,
    "architecture": "arm64",
    "families": [
      "r8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/minimap2-real/GRCh38_no_alt_analysis_set.fa",
      "destination": "/tmp/GRCh38_no_alt_analysis_set.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/minimap2-real/wg/",
      "destination": "/tmp/wg/"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/minimap2-real/wg-pins.sha256",
      "destination": "/tmp/wg-pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/minimap2-real/genome.sh",
      "destination": "/tmp/genome.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/minimap2-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/chr20.sam",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/chr20.sam"
    },
    {
      "source": "/tmp/results.tsv",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/results.tsv"
    },
    {
      "source": "/tmp/chunks.tsv",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/chunks.tsv"
    },
    {
      "source": "/tmp/body.md5",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/body.md5"
    },
    {
      "source": "/tmp/run.log",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/run.log"
    },
    {
      "source": "/tmp/minimap2.log",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/minimap2.log"
    },
    {
      "source": "/tmp/index.log",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/index.log"
    },
    {
      "source": "/tmp/cpu.txt",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/cpu.txt"
    },
    {
      "source": "/tmp/samp.tsv",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/minimap2-real/genome/samp.tsv"
    }
  ],
  "lifecycle": {
    "ttl": "4h",
    "on_complete": "terminate",
    "cost_limit": 4.0
  }
}

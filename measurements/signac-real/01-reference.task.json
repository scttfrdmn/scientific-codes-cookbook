    "set +e\nset -uo pipefail\n# spawn runs task commands under bash -e (spawn#707); the body is staged, not inlined\n# (EC2 user data is capped at 16 KiB, spawn#1063).\ncd /tmp\nprintf '06a104a7d81d8bf5aa2d53ce830ca06cd9395862a62f3ceb5ed164fbe7ef92e9  reference.sh\\n3f49f5a7687db4cc0240db8e9c7e5ca4b9e475c8104203e5de225f58cc8d2440  bins.awk\\n49c4e0aa28a9ca3a83cd4ac4ab523cda058e235bd02fd9532b2840433ea8ea77  overlap.awk\\n10dd78f743f3df54b2f23fd5971fb40c710d6bbe24bf5e3205d3378239f694eb  windows.awk\\n4d492941a253554c595985cec01e24ceb52c15c3f9c0055e40903158f96fdbd1  gtf.awk\\n2c5e4bef7d0955777b75fceff62d1517451326f8f8259e7fc04ccb8e8fdc7944  pins.sha256\\n' > scripts.sha256\nsha256sum -c scripts.sha256 || { echo \"FAIL: a staged script does not match its pin\"; exit 1; }\nbash /tmp/reference.sh > reference.log 2>&1; RC=$?\ncat reference.log\ntest \"$RC\" = 0 && grep -q '^REFERENCE OK' reference.log || { echo \"FAIL: reference.sh exited $RC\"; exit 1; }\necho DONE\n"

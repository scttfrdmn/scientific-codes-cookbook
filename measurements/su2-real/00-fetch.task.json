{
  "task_id": "cookbook-su2-real-fetch",
  "container": "quay.io/aarchsci/cfd-fv@sha256:830eaf94cc9a6b36d6307b08a702610f16ac9212235a984047fb8e329092ae46",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\nset -uo pipefail\nexport TMPDIR=/tmp HOME=/tmp PATH=/opt/conda/bin:$PATH\ncd /tmp\nmkdir -p /tmp/out\npython3 -u fetch.py manifest.tsv /tmp/out || { echo \"FAIL: fetch\"; exit 1; }\necho DONE\n"
  ],
  "resources": {
    "cpu": 1,
    "memory_gib": 2,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/su2-real/fetch.py",
      "destination": "/tmp/fetch.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/su2-real/manifest.tsv",
      "destination": "/tmp/manifest.tsv"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/su2-real/data/"
    }
  ],
  "lifecycle": {
    "ttl": "20m",
    "on_complete": "terminate",
    "cost_limit": 0.05
  }
}

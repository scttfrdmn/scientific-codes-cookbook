{
  "task_id": "cookbook-phasing-real-prep",
  "container": "quay.io/aarchbio/samtools@sha256:1191739637fb6f46ef97c02b28f693b25ca3ca61f90e1337f349b7b7cc0be4f7",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (prep\\.sh|lib\\.sh)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 2 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash prep.sh\n"
  ],
  "resources": {
    "cpu": 8,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "m8g"
    ],
    "disk_gib": 30
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/prep.sh",
      "destination": "/tmp/prep.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/lib.sh",
      "destination": "/tmp/lib.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bwa-samtools/chr20.fa",
      "destination": "/tmp/chr20.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/giab/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz",
      "destination": "/tmp/bench.vcf.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/giab/HG002_GRCh38_1_22_v4.2.1_benchmark_hifiasm_v11_phasetransfer.vcf.gz",
      "destination": "/tmp/hifiasm.vcf.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/giab/HG002_GRCh38_1_22_v4.2.1_benchmark_phased_MHCassembly_StrandSeqANDTrio.vcf.gz",
      "destination": "/tmp/sst.vcf.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/giab/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi",
      "destination": "/tmp/bench.vcf.gz.tbi"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/giab/HG002_GRCh38_1_22_v4.2.1_benchmark_hifiasm_v11_phasetransfer.vcf.gz.tbi",
      "destination": "/tmp/hifiasm.vcf.gz.tbi"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/giab/HG002_GRCh38_1_22_v4.2.1_benchmark_phased_MHCassembly_StrandSeqANDTrio.vcf.gz.tbi",
      "destination": "/tmp/sst.vcf.gz.tbi"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/phasing-real/prep/"
    }
  ],
  "lifecycle": {
    "ttl": "2h",
    "on_complete": "terminate",
    "cost_limit": 0.6
  }
}

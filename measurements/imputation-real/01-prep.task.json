{
  "task_id": "cookbook-imputation-real-prep",
  "container": "quay.io/aarchbio/minimac4@sha256:cea08321a8ab3632633b2ba0f2b68c98d7e6fcfb1c9c624f9b790a61a0e4b3c2",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (prep\\.sh|lib\\.sh|ALL\\.chr20\\.phase3_shapeit2_mvncall_integrated_v5a\\.20130502\\.genotypes\\.vcf\\.gz|omni\\.chr20\\.sites\\.tsv)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 4 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash prep.sh \n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 32,
    "architecture": "arm64",
    "families": [
      "c8g"
    ],
    "disk_gib": 40
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/prep.sh",
      "destination": "/tmp/prep.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/lib.sh",
      "destination": "/tmp/lib.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/omni.chr20.sites.tsv",
      "destination": "/tmp/omni.chr20.sites.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/plink-real/ALL.chr20.phase3_shapeit2_mvncall_integrated_v5a.20130502.genotypes.vcf.gz",
      "destination": "/tmp/ALL.chr20.phase3_shapeit2_mvncall_integrated_v5a.20130502.genotypes.vcf.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/imputation-real/prep/"
    }
  ],
  "lifecycle": {
    "ttl": "2h",
    "on_complete": "terminate",
    "cost_limit": 1.0
  }
}

{
  "task_id": "cookbook-imputation-real-sites",
  "container": "quay.io/aarchbio/minimac4@sha256:cea08321a8ab3632633b2ba0f2b68c98d7e6fcfb1c9c624f9b790a61a0e4b3c2",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (sites\\.sh|lib\\.sh)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 2 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash sites.sh \n"
  ],
  "resources": {
    "cpu": 4,
    "memory_gib": 8,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/sites.sh",
      "destination": "/tmp/sites.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/lib.sh",
      "destination": "/tmp/lib.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/ALL.chip.omni_broad_sanger_combined.20140818.snps.genotypes.vcf.gz",
      "destination": "/tmp/ALL.chip.omni_broad_sanger_combined.20140818.snps.genotypes.vcf.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/ALL.chip.omni_broad_sanger_combined.20140818.snps.genotypes.vcf.gz.tbi",
      "destination": "/tmp/ALL.chip.omni_broad_sanger_combined.20140818.snps.genotypes.vcf.gz.tbi"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/sites/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/imputation-real/"
    }
  ],
  "lifecycle": {
    "ttl": "30m",
    "on_complete": "terminate",
    "cost_limit": 0.1
  }
}

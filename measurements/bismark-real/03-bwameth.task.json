    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/prep-bwameth/bwameth/ref.fa.bwameth.c2t.amb",
      "destination": "/tmp/ref.fa.bwameth.c2t.amb"

      "destination": "/tmp/ref.fa.bwameth.c2t.ann"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/prep-bwameth/bwameth/ref.fa.bwameth.c2t.bwt",
      "destination": "/tmp/ref.fa.bwameth.c2t.bwt"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/prep-bwameth/bwameth/ref.fa.bwameth.c2t.pac",
      "destination": "/tmp/ref.fa.bwameth.c2t.pac"

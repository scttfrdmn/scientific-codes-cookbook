{
  "task_id": "cookbook-bismark-real-prep-bismark",
  "container": "quay.io/aarchbio/bismark@sha256:1bdd5895c5b9b458f8f4c1a19fd1b177f3ffab951262c37c543f2ce767150302",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (prep-bismark\\.sh|GRCh38_no_alt_analysis_set\\.fa)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 2 ] && sha256sum -c pins.sel > pins.check 2>&1 || { cat pins.check; echo \"FAIL: a staged input does not match its pin\"; exit 1; }\necho \"pins: $(wc -l < pins.sel) staged inputs match\"\nbash prep-bismark.sh 8 || exit 1\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 64,
    "architecture": "arm64",
    "families": [
      "m8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/minimap2-real/GRCh38_no_alt_analysis_set.fa",
      "destination": "/tmp/GRCh38_no_alt_analysis_set.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/ENCFF000LYO.fastq.gz",
      "destination": "/tmp/ENCFF000LYO.fastq.gz"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/prep-bismark.sh",
      "destination": "/tmp/prep-bismark.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/prep/"
    },
    {
      "source": "/tmp/genome/Bisulfite_Genome/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/bismark-real/Bisulfite_Genome/"
    }
  ],
  "lifecycle": {
    "ttl": "5h",
    "on_complete": "terminate",
    "cost_limit": 3.0
  }
}

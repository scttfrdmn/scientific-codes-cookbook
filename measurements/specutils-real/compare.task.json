  "command": [
    "bash",
    "-c",
    "set +e\nset -uo pipefail\nexport PATH=/opt/conda/bin:$PATH HOME=/tmp\nmkdir -p /tmp/out\necho '6a711130af578bb2efe2365380fefc575a8b431cdd431cf6b13824a19fac565f  /tmp/compare.py' | sha256sum -c - || { echo 'FAIL: compare.py does not match its pin'; exit 1; }\npython3 -u /tmp/compare.py /tmp/cmp > /tmp/out/compare.log 2>&1; RC=$?\ncat /tmp/out/compare.log\n[ $RC = 0 ] && grep -q 'COMPARE DONE' /tmp/out/compare.log && test -s /tmp/out/crosschip.txt || { echo FAIL; exit 1; }\n"
  ],

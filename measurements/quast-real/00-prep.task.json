{
  "task_id": "cookbook-quast-real-prep",
  "container": "quay.io/aarchbio/sra-tools@sha256:7145cf2f6f2e9265b7ace204d86b6ed1cbbd0b8b3ef31cbadf32bfa271229afd",
  "command": [
    "bash",
    "-c",
    "set +e\ncd /tmp\ngrep -E ' (prep\\.sh|assemblies\\.tsv)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -eq 2 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash prep.sh assemblies.tsv || exit 1\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 4,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/quast-real/prep.sh",
      "destination": "/tmp/prep.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/quast-real/assemblies.tsv",
      "destination": "/tmp/assemblies.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/quast-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/inputs/quast-real/prep/"
    }
  ],
  "lifecycle": {
    "ttl": "30m",
    "on_complete": "terminate",
    "cost_limit": 0.05
  }
}

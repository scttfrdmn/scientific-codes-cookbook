{
  "task_id": "cookbook-imagecodecs-real-canary",
  "container": "quay.io/aarchsci/pathology@sha256:9c7f7713f34ef818acc7aa07ee9084e8df293666277497bccb297d966797fc5a",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\nsha256sum -c pins.sha256 || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nSLIDES=test_065,tumor_091,test_013,test_108 bash run.sh 4\n"
  ],
  "resources": {
    "cpu": 8,
    "memory_gib": 16,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imagecodecs-real/real.py",
      "destination": "/tmp/real.py"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imagecodecs-real/run.sh",
      "destination": "/tmp/run.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/pathology-real/slides.tsv",
      "destination": "/tmp/slides.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/imagecodecs-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/imagecodecs-real/canary/"
    }
  ],
  "lifecycle": {
    "ttl": "90m",
    "on_complete": "terminate",
    "cost_limit": 0.6
  }
}

    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/neuroimaging-real/fsl-dtifit-linux-64.lock",
      "destination": "/tmp/locks/fsl-dtifit-linux-64.lock"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/neuroimaging-real/fsl.sh",
      "destination": "/tmp/fsl.sh"
    }
  ],
  "outputs": [

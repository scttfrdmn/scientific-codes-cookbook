{
  "task_id": "neuroreal-fsl-cohort",
  "container": "docker.io/mambaorg/micromamba@sha256:26c186ed2c9fdfd7aab1e7f8416b6ef54358557db8a0d9a7d11a07d1d224f1b2",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\nprintf 'e5bf0a7d0748c84da5fb4329df091a74fb9969b61c02f88a86e68be3d993181e  /tmp/fsl.sh\\n' | sha256sum -c --quiet || { echo \"FAIL: a script does not match its pin\"; exit 1; }\nbash /tmp/fsl.sh 16 0\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 64,
    "architecture": "arm64",
    "families": [
      "m8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/neuroimaging-real/dwi/",
      "destination": "/tmp/dwi/"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/neuroimaging-real/subjects.txt",
      "destination": "/tmp/subjects.txt"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/neuroimaging-real/dwi.sha256",
      "destination": "/tmp/dwi.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/fsl/pkgs/",
      "destination": "/tmp/pkgs/"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/neuroimaging-real/pkgs/",
      "destination": "/tmp/xpkgs/"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/neuroimaging-real/fsl-dtifit-linux-aarch64.lock",
      "destination": "/tmp/locks/fsl-dtifit-linux-aarch64.lock"

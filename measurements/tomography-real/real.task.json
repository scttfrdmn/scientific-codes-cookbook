{
  "task_id": "cookbook-tomography-real",
  "container": "quay.io/aarchsci/tomography@sha256:ea7b4900500f3eb23d3060611f1737175f4a6421cb24b4f29a809765b2754026",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\nsha256sum -c pins.sha256 || { echo \"FAIL: a staged file does not match its pin\"; exit 1; }\nbash real.sh 16\n"
  ],
  "resources": {
    "cpu": 16,
    "memory_gib": 128,
    "architecture": "arm64",
    "families": [
      "r8g"
    ]
  },
  "inputs": [
    {"source": "s3://${COOKBOOK_BUCKET}/inputs/tomography-real/data/proj.zip", "destination": "/tmp/proj.zip"},
    {"source": "s3://${COOKBOOK_BUCKET}/inputs/tomography-real/data/rec.zip", "destination": "/tmp/rec.zip"},
    {"source": "s3://${COOKBOOK_BUCKET}/inputs/tomography-real/real.py", "destination": "/tmp/real.py"},
    {"source": "s3://${COOKBOOK_BUCKET}/inputs/tomography-real/real.sh", "destination": "/tmp/real.sh"},
    {"source": "s3://${COOKBOOK_BUCKET}/inputs/tomography-real/pins.sha256", "destination": "/tmp/pins.sha256"}
  ],
  "outputs": [
    {"source": "/tmp/out/", "destination": "s3://${COOKBOOK_BUCKET}/runs/tomography-real/real/"}
  ],
  "lifecycle": {
    "ttl": "4h",
    "on_complete": "terminate",
    "cost_limit": 3.0
  }
}

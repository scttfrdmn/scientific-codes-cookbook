{
  "task_id": "cookbook-tomography-real-compare",
  "container": "quay.io/aarchsci/tomography@sha256:ea7b4900500f3eb23d3060611f1737175f4a6421cb24b4f29a809765b2754026",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\nmkdir -p /tmp/out\n{\n  for b in x86_64 amd; do echo \"== Graviton4 vs $b\"; python3 -I compare.py /tmp/arm64 /tmp/$b; echo; done\n  echo \"== Intel vs AMD (the same x86 env twin)\"; python3 -I compare.py /tmp/x86_64 /tmp/amd\n} > /tmp/out/compare.txt 2>&1\nRC=$?\ncat /tmp/out/compare.txt\nexit $RC\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 8,
    "architecture": "arm64",
    "families": [
      "m8g"
    ]
  },
  "inputs": [
    {"source": "s3://${COOKBOOK_BUCKET}/inputs/tomography-real/compare.py", "destination": "/tmp/compare.py"},
    {"source": "s3://${COOKBOOK_BUCKET}/runs/tomography-real/real/r1/", "destination": "/tmp/arm64/"},
    {"source": "s3://${COOKBOOK_BUCKET}/runs-x86_64/tomography-real/real/r1/", "destination": "/tmp/x86_64/"},
    {"source": "s3://${COOKBOOK_BUCKET}/runs-amd/tomography-real/real/r1/", "destination": "/tmp/amd/"}
  ],
  "outputs": [
    {"source": "/tmp/out/", "destination": "s3://${COOKBOOK_BUCKET}/runs/tomography-real/compare/"}
  ],
  "lifecycle": {
    "ttl": "30m",
    "on_complete": "terminate",
    "cost_limit": 0.1
  }
}

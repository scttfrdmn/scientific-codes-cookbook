{
  "task_id": "cookbook-bcftools-real",
  "container": "quay.io/aarchbio/bcftools@sha256:8171fe74464620a0585cc8998fd9bacbfc04480ac5571229f22f390ecfd5658e",
  "command": [
    "bash",
    "-c",
    "set +e\nset -uo pipefail\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\nexport PATH=/opt/conda/bin:$PATH THREADS=4\ncd /tmp\necho '== staged bytes must match their pins =='\nsha256sum -c pins.sha256 || { echo 'FAIL: a staged input does not match its pin'; exit 1; }\nlscpu > cpu.txt 2>/dev/null || cat /proc/cpuinfo > cpu.txt\nT0=$(date +%s)\nbash run.sh > run.log 2>&1\nRC=$?\necho \"run.sh exit $RC in $(( $(date +%s) - T0 ))s\"\ncat run.log\ntest \"$RC\" = 0 || { echo 'FAIL: the workload failed'; exit 1; }\ngrep -q 'BCFTOOLS REAL OK' run.log || { echo 'FAIL: no completion sentinel'; exit 1; }\necho DONE\n"
  ],
  "resources": {
    "cpu": 8,
    "memory_gib": 16,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },

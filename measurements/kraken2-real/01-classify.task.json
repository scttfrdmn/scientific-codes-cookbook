{
  "task_id": "cookbook-kraken2-real-classify",
  "container": "quay.io/aarchbio/kraken2@sha256:fc6dd9becb7fec054ee01575d85e12c7fc509e53001c0ade5ed2e095c3cbe455",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\nexport PATH=/opt/conda/bin:/usr/local/bin:$PATH TMPDIR=/tmp HOME=/tmp\ncd /tmp\nmkdir -p out\nT0=$(date +%s)\nsha256sum -c pins.sha256 2>&1 | tee out/pins-check.txt\n[ \"$(grep -c ': OK$' out/pins-check.txt)\" = 8 ] || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\necho \"pins_check_s $(( $(date +%s) - T0 ))\" | tee out/pins-time.txt\npython3 -u classify.py 8 ERR2984773:8785731:2653290762:even ERR2935805:47832553:9662175706:log\n"
  ],
  "resources": {
    "cpu": 8,
    "memory_gib": 60,
    "disk_gib": 60,
    "architecture": "arm64",
    "families": [
      "r8g"
    ]
  },
  "inputs": [

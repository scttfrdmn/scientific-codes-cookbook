{
  "task_id": "cookbook-mrbayes-real-compare",
  "container": "quay.io/aarchbio/iqtree@sha256:dc6d9f62d56fd1ca92bfb2a9fbd162d419d4f866de67e6e879ba0f895d2a6fb7",
  "command": [
    "bash",
    "-c",
    "set +e\n# spawn runs task commands under bash -e; `set -uo pipefail` does not clear it (spawn#707).\ncd /tmp\ngrep -E ' (compare\\.sh|splits\\.awk|aln\\.fa|iqout\\.treefile|iqout\\.iqtree|rx\\.raxml\\.bestTree|rx\\.raxml\\.bestModel|rx\\.raxml\\.log)$' pins.sha256 > pins.sel\n[ \"$(wc -l < pins.sel)\" -ge 8 ] && sha256sum -c pins.sel || { echo \"FAIL: a staged input does not match its pin\"; exit 1; }\nbash compare.sh\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 4,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/iqtree/pfam38.2_seed_alignment.fa",
      "destination": "/tmp/aln.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/compare.sh",
      "destination": "/tmp/compare.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/splits.awk",
      "destination": "/tmp/splits.awk"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/iqout.treefile",
      "destination": "/tmp/iqout.treefile"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/iqout.iqtree",
      "destination": "/tmp/iqout.iqtree"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/rx.raxml.bestTree",
      "destination": "/tmp/rx.raxml.bestTree"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/rx.raxml.bestModel",
      "destination": "/tmp/rx.raxml.bestModel"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/rx.raxml.log",
      "destination": "/tmp/rx.raxml.log"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/pins.sha256",
      "destination": "/tmp/pins.sha256"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/mrbayes-real/mcmc/score.tsv",
      "destination": "/tmp/mb.score.tsv"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/mrbayes-real/mcmc/mb.consensus.nwk",
      "destination": "/tmp/mb.consensus.nwk"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/mrbayes-real/mcmc/mb.tstat",
      "destination": "/tmp/mb.tstat"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/mrbayes-real/mcmc/mb.out",
      "destination": "/tmp/mb.out"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes-real/graviton4/mb.consensus.nwk",
      "destination": "/tmp/g4.consensus.nwk"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/out/",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/mrbayes-real/compare/"
    }
  ],
  "lifecycle": {
    "ttl": "30m",
    "on_complete": "terminate",
    "cost_limit": 0.1
  }
}

  "command": [
    "bash",
    "-c",
    "set +e\nset -uo pipefail\nexport PATH=/opt/conda/bin:$PATH\nexport TMPDIR=/tmp HOME=/tmp\ncd /tmp\nprintf '07ea24aa42a11ef71f76d961cecdb52629e46c22d85ecf4cfc13b538e81f77d3  compare.sh\\n' | sha256sum -c || { echo 'FAIL: compare.sh does not match its pin'; exit 1; }\n# A pipeline, not exec > >(tee): bash waits for tee, so the log cannot lose its tail when the container exits.\nprintf '%s\\n' \"$(sha256sum compare.sh)\" > /tmp/compare.log\nbash compare.sh 2>&1 | tee -a /tmp/compare.log\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 4,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/inputs/mrbayes/compare.sh",
      "destination": "/tmp/compare.sh"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/mrbayes/r1/mb.consensus.nwk",
      "destination": "/tmp/mb.consensus.nwk"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/mrbayes/r1/mb.tstat",
      "destination": "/tmp/mb.tstat"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/iqtree/r1/iqout.treefile",
      "destination": "/tmp/iqout.treefile"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/raxml-ng/r1/rx.raxml.bestTree",
      "destination": "/tmp/rx.raxml.bestTree"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/compare.log",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/mrbayes/r1/compare.log"
    }
  ],
  "lifecycle": {
    "ttl": "30m",
    "on_complete": "terminate",
    "cost_limit": 0.1
  }
}

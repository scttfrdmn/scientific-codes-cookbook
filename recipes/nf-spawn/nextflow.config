// nf-spawn executor: every process step runs on its own ephemeral EC2 instance via
// `spawn task run`, self-terminating on completion; Nextflow's S3 work dir carries
// data between stages (the instance is gone by the time the next stage reads it).
//
// nf-spawn v0.10.1 fixed the three findings this recipe originally filed
// (spore-host/nf-spawn#90/#91/#92 — see README history). The plugin is still not in
// the Nextflow plugin registry, so install it from the release zip first (the zip
// ships a bare classes/ dir, so extract it INTO a version-named plugin dir):
//   curl -sSL -o /tmp/nf-spawn-0.10.1.zip \
//     https://github.com/spore-host/nf-spawn/releases/download/v0.10.1/nf-spawn-0.10.1.zip
//   mkdir -p ~/.nextflow/plugins/nf-spawn-0.10.1
//   unzip -o /tmp/nf-spawn-0.10.1.zip -d ~/.nextflow/plugins/nf-spawn-0.10.1/
// The 0.10.1 manifest genuinely reports Plugin-Version: 0.10.1 (the #91 mismatch is gone).
plugins {
    id 'nf-spawn@0.10.1'
}

// S3 work dir is REQUIRED for a multi-instance pipeline — it's the handoff medium.
workDir = "s3://${System.getenv('COOKBOOK_BUCKET')}/nextflow-work/nf-spawn-r3"

// The instances must launch in the region the work dir lives in, or every stage handoff
// crosses regions. Measured: this was hardcoded 'us-east-1' against a us-west-2 bucket
// and the DAG still succeeded — five green stages, every .exitcode 0, the right RF —
// while each of the five instances pulled and pushed its intermediates across the
// continent. Nothing in Nextflow's summary or spawn's completion records says so.
// So it is read from the environment rather than hardcoded to something that was true
// once. The Makefile builds COOKBOOK_BUCKET as cookbook-<account>-<region> from the same
// AWS_REGION, so the two agree by construction. main.nf fails loudly if it is unset —
// this file cannot, because Nextflow's config DSL rejects `def` and `if` among config
// statements ("Variable declarations cannot be mixed with config statements").

process {
    executor = 'spawn'
    ext.region = System.getenv('AWS_REGION') ?: System.getenv('AWS_DEFAULT_REGION')

    // No ext.setup socket workaround: v0.10.1 fixed #92 (the executor now reaches the
    // Docker socket on the task instance itself). Dropping it is the actual test of the fix.

    // per-rule instance sizing (the Shape-F cost model is per job, not one flat task)
    withName: 'MAFFT'      { ext.instanceType = 'c8g.large';  ext.ttl = '10m' }
    withName: 'MUSCLE'     { ext.instanceType = 'c8g.large';  ext.ttl = '10m' }
    withName: 'TREE'       { ext.instanceType = 'c8g.xlarge'; ext.ttl = '15m' }
    withName: 'OBSERVE_RF' { ext.instanceType = 'c8g.large';  ext.ttl = '10m' }
}

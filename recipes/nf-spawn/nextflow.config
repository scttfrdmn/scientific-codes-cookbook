// nf-spawn executor: every process step runs on its own ephemeral EC2 instance via
// `spawn task run`, self-terminating on completion; Nextflow's S3 work dir carries
// data between stages (the instance is gone by the time the next stage reads it).
//
// NOTE the plugin version: the v0.10.0 release ASSET ships a manifest versioned
// 0.8.0 (spore-host/nf-spawn#91), so the id below must match what actually installs.
// And it is NOT in the Nextflow plugin registry (spore-host/nf-spawn#90), so install
// it first from the release zip:
//   curl -sSL -o /tmp/nf-spawn.zip \
//     https://github.com/spore-host/nf-spawn/releases/download/v0.10.0/nf-spawn-0.10.0.zip
//   unzip -o /tmp/nf-spawn.zip -d ~/.nextflow/plugins/     # -> ~/.nextflow/plugins/nf-spawn-0.8.0/
plugins {
    id 'nf-spawn@0.8.0'
}

// S3 work dir is REQUIRED for a multi-instance pipeline — it's the handoff medium.
workDir = 's3://scicookbook-942542972736-us-east-1/nextflow-work/nf-spawn-r1'

process {
    executor = 'spawn'
    ext.region = 'us-east-1'

    // MITIGATION (spore-host/nf-spawn finding, see README): nf-spawn runs the process
    // container via `docker run` on the task instance, but as a user NOT in the docker
    // group, so it fails exit 126 "permission denied ... /var/run/docker.sock". ext.setup
    // runs after Docker install and before the task; loosen the socket on the ephemeral,
    // single-use instance so nf-spawn's docker call can reach it. Honest workaround on a
    // box that's tearing down anyway — not a fix; filed upstream.
    ext.setup = 'sudo chmod 666 /var/run/docker.sock'

    // per-rule instance sizing (the Shape-F cost model is per job, not one flat task)
    withName: 'MAFFT'      { ext.instanceType = 'c8g.large';  ext.ttl = '10m' }
    withName: 'MUSCLE'     { ext.instanceType = 'c8g.large';  ext.ttl = '10m' }
    withName: 'TREE'       { ext.instanceType = 'c8g.xlarge'; ext.ttl = '15m' }
    withName: 'OBSERVE_RF' { ext.instanceType = 'c8g.large';  ext.ttl = '10m' }
}

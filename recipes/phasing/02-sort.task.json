{
  "task_id": "cookbook-phasing-sort-r1",
  "container": "quay.io/aarchbio/samtools@sha256:1191739637fb6f46ef97c02b28f693b25ca3ca61f90e1337f349b7b7cc0be4f7",
  "command": [
    "bash",
    "-c",
    "set -euo pipefail\nexport PATH=/opt/conda/bin:$PATH\nexport TMPDIR=/tmp HOME=/tmp\ncd /tmp\nsamtools sort -o sample.bam aln.sam 2> sort.log\nsamtools index sample.bam\nsamtools faidx ref.fa\nsamtools view -c sample.bam | awk '{print \"bam_records\", $1}'\nsamtools view -H sample.bam | awk '/^@RG/{print \"rg\", $0}'\necho \"SORT OK\"\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 4,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/phasing/r1/ref.fa",
      "destination": "/tmp/ref.fa"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/phasing/r1/aln.sam",
      "destination": "/tmp/aln.sam"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/sample.bam",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/phasing/r1/sample.bam"
    },
    {
      "source": "/tmp/sample.bam.bai",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/phasing/r1/sample.bam.bai"
    },
    {
      "source": "/tmp/ref.fa.fai",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/phasing/r1/ref.fa.fai"
    }
  ],
  "lifecycle": {
    "ttl": "12m",
    "on_complete": "terminate",
    "cost_limit": 0.05
  }
}
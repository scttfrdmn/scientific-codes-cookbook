{
  "task_id": "cookbook-bismark-sort-r1",
  "container": "quay.io/aarchbio/samtools@sha256:1191739637fb6f46ef97c02b28f693b25ca3ca61f90e1337f349b7b7cc0be4f7",
  "command": [
    "bash",
    "-c",
    "set -euo pipefail\nexport PATH=/opt/conda/bin:$PATH\nexport TMPDIR=/tmp HOME=/tmp\ncd /tmp\n\necho \"== MethylDackel requires a coordinate-sorted, indexed BAM; Bismark writes read-order ==\"\nsamtools sort -o sorted.bam reads_bismark_bt2.bam\nsamtools index sorted.bam\nsamtools faidx chrS.fa\nsamtools view -c sorted.bam | awk '{print \"sorted_bam_records\", $1}'\n"
  ],
  "resources": {
    "cpu": 2,
    "memory_gib": 4,
    "architecture": "arm64",
    "families": [
      "c8g"
    ]
  },
  "inputs": [
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/bismark/r1/reads_bismark_bt2.bam",
      "destination": "/tmp/reads_bismark_bt2.bam"
    },
    {
      "source": "s3://${COOKBOOK_BUCKET}/runs/bismark/r1/chrS.fa",
      "destination": "/tmp/chrS.fa"
    }
  ],
  "outputs": [
    {
      "source": "/tmp/sorted.bam",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/bismark/r1/sorted.bam"
    },
    {
      "source": "/tmp/sorted.bam.bai",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/bismark/r1/sorted.bam.bai"
    },
    {
      "source": "/tmp/chrS.fa.fai",
      "destination": "s3://${COOKBOOK_BUCKET}/runs/bismark/r1/chrS.fa.fai"
    }
  ],
  "lifecycle": {
    "ttl": "12m",
    "on_complete": "terminate",
    "cost_limit": 0.05
  }
}